generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MediaType {
  IMAGE
  VIDEO
}

model User {
  id       String  @id @default(uuid())
  name     String
  username String  @unique
  email    String  @unique
  password String
  bio      String?
  image    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshToken RefreshToken[]

  posts Post[]
  likes Like[]
  comments Comment[]
  savedPosts SavedPosts[]
  followers Follow[] @relation("followers")
  following Follow[] @relation("following")
  user Notification[] @relation("UserNotifications")
  actor Notification[] @relation("ActorNotifications") 

  @@index([email])
}

model RefreshToken {
  id     String @id @default(uuid())
  userId String
  token  String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Follow {
  id String @id @default(uuid())

  followerId  String
  followingId String

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Post {
  id  String @id @default(uuid())
  content String
  mediaUrl String?
  mediaType MediaType?
  authorId String
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes Like[]
  comments Comment[]
  savedBy SavedPosts[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([createdAt])
}

model Like {
  id  String @id @default(uuid())
  userId String
  postId String

  user  User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post  Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Comment {
  id  String @id @default(uuid())
  userId String
  postId String
  parentId String?
  content String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent    Comment? @relation("Reply", fields: [parentId], references: [id])
  replies   Comment[] @relation("Reply")

  notifications Notification[] 

  createdAt DateTime @default(now())

  @@index([postId])
  @@index([parentId])
}

model SavedPosts {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model Notification {
  id        String   @id @default(uuid())
  type      NotificationType
  userId    String
  actorId   String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user  User @relation("UserNotifications", fields: [userId], references: [id])
  actor User @relation("ActorNotifications", fields: [actorId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])

}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
}
